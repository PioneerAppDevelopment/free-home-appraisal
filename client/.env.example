# ============================================================
# ACCUPRAISAL — Frontend Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to source control.
# ============================================================

# ----------------------------------------------------------
# Google Maps API Key (REQUIRED for maps, street view, and address autocomplete)
# Generate at: https://console.cloud.google.com/apis/credentials
# Enable these APIs on the key: Maps JavaScript API, Street View Static API, Places API
# ----------------------------------------------------------
REACT_APP_GOOGLE_MAP_API_KEY=your_google_maps_api_key_here

# ----------------------------------------------------------
# NOTE: The keys below are only needed if/when the backend
# estimate integrations are re-implemented in services/api.js.
# Leave them blank during frontend-only development —
# mock data in services/api.js will be used instead.
# ----------------------------------------------------------

# Zillow API (ZWSID)
# Register at: https://www.zillow.com/howto/api/APIOverview.htm
# Note: Zillow's public API has been deprecated — check for current access options.
REACT_APP_ZILLOW_TOKEN=your_zillow_token_here

# Melissa Data Property API
# Register at: https://www.melissa.com/developer
REACT_APP_MELISSA_TOKEN=your_melissa_token_here

# RapidAPI Key (used for Realtor, Realty Mole, and Mashvisor APIs)
# Register at: https://rapidapi.com
# Subscribe to: Realtor, Realty Mole Property API, Mashvisor
REACT_APP_RAPIDAPI_KEY=your_rapidapi_key_here

# ----------------------------------------------------------
# DEVELOPMENT WITHOUT API KEYS
# ----------------------------------------------------------
# The app works out of the box without any keys except Google Maps.
# All property estimates come from hardcoded mock data in:
#   client/src/services/api.js
# Edit that file freely to simulate different property data
# while building features before wiring up real API calls.
