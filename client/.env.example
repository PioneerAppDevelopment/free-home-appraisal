# ============================================================
# ACCUPRAISAL — Frontend Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to source control.
# ============================================================

# ----------------------------------------------------------
# Google Maps API Key (REQUIRED for maps, street view, and address autocomplete)
# Generate at: https://console.cloud.google.com/apis/credentials
# Enable these APIs on the key: Maps JavaScript API, Street View Static API, Places API
# ----------------------------------------------------------
REACT_APP_GOOGLE_MAP_API_KEY=your_google_maps_api_key_here
REACT_APP_API_URL=
REACT_APP_USE_MOCKS=false

# ----------------------------------------------------------
# Server-side estimate provider key. Configure this in Vercel
# project environment variables, not in browser-exposed React vars.
# ----------------------------------------------------------

# RealtyAPI powers Zillow, Redfin, Realtor.com, and Homes.com adapters.
REALTYAPI_KEY=your_realtyapi_key_here
